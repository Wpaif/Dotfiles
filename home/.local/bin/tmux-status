#!/bin/sh
# tmux-status: segmentos da barra. Uso: tmux-status cpu|battery|ram|git <path>|net
case "$1" in
cpu)
    state=${XDG_STATE_HOME:-$HOME/.local/state}/tmux
    mkdir -p "$state" || exit 0
    f=$state/cpu
    read -r _ u n s i w q sq steal _ < /proc/stat
    tot=$((u + n + s + i + w + q + sq + steal)); idle=$((i + w))
    [ -r "$f" ] && read -r pt pi < "$f" || { pt=$tot; pi=$idle; }
    (umask 077; printf '%s %s\n' "$tot" "$idle" > "$f.$$")
    mv -f "$f.$$" "$f"
    dt=$((tot - pt))
    [ "$dt" -gt 0 ] && echo " $((100 * (dt - (idle - pi)) / dt))%" || echo " --"
    ;;
battery)
    total=0; count=0; charging=0
    for battery in /sys/class/power_supply/*; do
        [ -r "$battery/type" ] && [ "$(cat "$battery/type")" = Battery ] || continue
        [ ! -r "$battery/present" ] || [ "$(cat "$battery/present")" != 0 ] || continue
        [ -r "$battery/capacity" ] || continue
        capacity=$(cat "$battery/capacity")
        case $capacity in ''|*[!0-9]*) continue ;; esac
        total=$((total + capacity)); count=$((count + 1))
        [ "$(cat "$battery/status" 2>/dev/null)" != Charging ] || charging=1
    done
    [ "$count" -gt 0 ] || exit 0
    capacity=$((total / count))
    icon=󰁹
    [ "$capacity" -gt 20 ] || icon=󰂎
    [ "$charging" -eq 0 ] || icon=󰂄
    printf '%s %s%%\n' "$icon" "$capacity"
    ;;
ram)
    awk '/^MemTotal/{t=$2} /^MemAvailable/{a=$2} END{printf "󰍛 %.1fG\n", (t-a)/1048576}' /proc/meminfo
    ;;
git)
    cd "$2" 2>/dev/null || exit 0
    b=$(git symbolic-ref --short -q HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null) || exit 0
    [ -n "$(git status --porcelain 2>/dev/null | head -1)" ] && d="*" || d=""
    echo " $b$d"
    ;;
net)
    ssid=$(nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}')
    ip=$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="src") print $(i+1)}')
    [ -n "$ip" ] && echo "󰖩 ${ssid:+$ssid }$ip" || echo "󰖪 offline"
    ;;
esac
